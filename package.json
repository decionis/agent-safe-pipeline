{
  "name": "agent-safe-pipeline-workspace",
  "version": "0.1.3",
  "private": true,
  "description": "Reference architecture for executing AI-agent actions through an independent authorization boundary.",
  "license": "Apache-2.0",
  "author": "Decionis, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decionis/agent-safe-pipeline.git"
  },
  "bugs": {
    "url": "https://github.com/decionis/agent-safe-pipeline/issues"
  },
  "homepage": "https://github.com/decionis/agent-safe-pipeline#readme",
  "packageManager": "pnpm@9.15.3",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.6",
      "qs": "6.16.0",
      "vite": "^6.4.3"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dependabot:check": "node scripts/CheckDependabotCoverage.mjs",
    "discovery": "node scripts/CheckDiscovery.mjs",
    "dossiers:check": "node scripts/GenerateDossierCorpus.mjs --check",
    "dossiers:regenerate": "node scripts/GenerateDossierCorpus.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "hooks:install": "simple-git-hooks",
    "fixture:check": "node scripts/CheckFixtureProvenance.mjs",
    "fuzz": "pnpm --filter @decionis/agent-safe-pipeline test:fuzz",
    "license:inventory": "node scripts/GenerateLicenseInventory.mjs",
    "license:check": "node scripts/CheckLicenses.mjs",
    "metadata:check": "node scripts/CheckReleaseMetadata.mjs",
    "lint": "eslint . && pnpm lint:markdown",
    "lint:markdown": "markdownlint-cli2",
    "performance": "pnpm --filter @decionis/agent-safe-pipeline test:performance",
    "mutation": "pnpm --filter @decionis/agent-safe-pipeline test:mutation",
    "precommit": "node scripts/PreCommit.mjs && pnpm metadata:check && pnpm fixture:check && pnpm dossiers:check && pnpm license:check && pnpm lint && pnpm security && pnpm performance",
    "prepare": "simple-git-hooks",
    "reproducible:compare": "node scripts/ComparePackageBuilds.mjs",
    "security": "pnpm security:production && pnpm security:toolchain",
    "security:production": "pnpm audit --prod --audit-level low",
    "security:toolchain": "pnpm audit --audit-level moderate",
    "test": "pnpm -r test",
    "test:automation": "node --test test/automation/*.test.mjs",
    "typecheck": "pnpm --filter @decionis/agent-safe-pipeline build && pnpm -r typecheck",
    "verify": "pnpm format && pnpm lint && pnpm metadata:check && pnpm fixture:check && pnpm dossiers:check && pnpm license:check && pnpm security && pnpm dependabot:check && pnpm discovery && pnpm performance && pnpm typecheck && pnpm test:automation && pnpm test && pnpm build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm precommit"
  },
  "devDependencies": {
    "@decionis/verify": "0.2.0",
    "@eslint/js": "^9.16.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.16.0",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-regexp": "^3.2.0",
    "globals": "^17.12.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.2.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
