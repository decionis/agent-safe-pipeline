{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/decionis/agent-safe-pipeline/blob/master/spec/profiles/mcp/v1/schema.json",
  "title": "agent-safe.profile.mcp/1",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "agent-safe.profile.mcp/1"
    },
    "id": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*\\/[a-z][a-z0-9]*\\/v\\d+(\\.\\d+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tools": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][\\w.:/-]*$"
          },
          "action": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9._:-]*$"
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "subject": {
            "type": "string",
            "pattern": "^[a-z]\\w{0,63}$"
          },
          "consequential": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]\\w{0,63}$"
            }
          },
          "arguments": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]\\w{0,63}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "array",
                    "object"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "tool",
          "action",
          "operation",
          "summary",
          "target",
          "consequential",
          "arguments"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile",
    "id",
    "title",
    "system",
    "tools"
  ],
  "additionalProperties": false
}
