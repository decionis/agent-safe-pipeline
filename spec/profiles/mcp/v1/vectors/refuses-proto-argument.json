{
  "description": "An argument name starts with a letter, so no name can reach an object's prototype.",
  "definition": {
    "profile": "agent-safe.profile.mcp/1",
    "id": "erp/mcp/v1",
    "title": "Synthetic ERP MCP server",
    "system": "erp.example",
    "environment": "test",
    "tools": [
      {
        "tool": "update_credit_limit",
        "action": "customer.credit_limit.update",
        "operation": "customers.updateCreditLimit",
        "summary": "Set a customer's credit limit.",
        "target": "erp:customer:{customerNumber}",
        "subject": "customerNumber",
        "consequential": ["customerNumber", "creditLimit"],
        "arguments": {
          "customerNumber": {
            "type": "string",
            "required": true,
            "maxLength": 50
          },
          "creditLimit": {
            "type": "number",
            "required": true
          },
          "note": {
            "type": "string",
            "maxLength": 200
          },
          "_hidden": {
            "type": "string"
          }
        }
      }
    ]
  },
  "error": "MCP_PROFILE_INVALID"
}
