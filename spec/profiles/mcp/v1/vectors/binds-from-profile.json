{
  "description": "A profiled tool becomes its action, its target filled from the arguments, the consequential arguments it was called with, and the session's subject.",
  "definition": {
    "profile": "agent-safe.profile.mcp/1",
    "id": "erp/mcp/v1",
    "title": "Synthetic ERP MCP server",
    "system": "erp.example",
    "environment": "test",
    "tools": [
      {
        "tool": "update_credit_limit",
        "action": "customer.credit_limit.update",
        "operation": "customers.updateCreditLimit",
        "summary": "Set a customer's credit limit.",
        "target": "erp:customer:{customerNumber}",
        "subject": "customerNumber",
        "consequential": ["customerNumber", "creditLimit"],
        "arguments": {
          "customerNumber": {
            "type": "string",
            "required": true,
            "maxLength": 50
          },
          "creditLimit": {
            "type": "number",
            "required": true
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      {
        "tool": "refresh_exchange_rates",
        "action": "currency.rates.refresh",
        "operation": "currencies.refreshRates",
        "summary": "Refresh exchange rates from the bank feed.",
        "target": "erp:currencies",
        "consequential": [],
        "arguments": {
          "currencies": {
            "type": "array"
          }
        }
      }
    ]
  },
  "invocation": {
    "tool": "update_credit_limit",
    "arguments": {
      "customerNumber": "C-10000",
      "creditLimit": 2500
    }
  },
  "session": "C-10000",
  "expected": {
    "action": "customer.credit_limit.update",
    "target": "erp:customer:C-10000",
    "operation": "customers.updateCreditLimit",
    "system": "erp.example",
    "environment": "test",
    "consequential": ["customerNumber", "creditLimit"],
    "session": {
      "subject": "C-10000"
    }
  }
}
