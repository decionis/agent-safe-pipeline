                "keyId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{86}$"
                }
              },
              "required": ["algorithm", "keyId", "value"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "public_jwks_path": {
          "type": "string",
          "const": "/.well-known/decision-dossier-jwks.json"
        }
      },
      "required": [
        "artifact",
        "artifact_sha256",
        "canonicalization",
        "verification",
        "signature",
        "public_jwks_path"
      ],
      "additionalProperties": false
    }
  }
