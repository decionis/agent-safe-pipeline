  "endpoints": {
    "submit": "POST /v1/outcomes/evidence",
    "statements": "GET /v1/outcomes/statements?period=YYYY-MM",
    "statement": "GET /v1/outcomes/statements/{statementId}"
  },
  "limits": {
    "batch": 1000,
    "reasons": 30,
    "exclusions": 10
  },
  "semantic_constraints": [
    "Only a producer service credential with the outcomes capability may submit; a customer key never feeds the meter.",
    "A subject's revision increases whenever its evidence changes; the same subject and revision with different content is refused.",
    "Business identifiers never leave the producer: subject_digest and source_sha256 are SHA-256 hex digests.",
    "Amounts are integer minor units in the transaction currency and are never converted by the producer.",
    "A held action is CONFIRMED_PROBLEM only when a person established it; absence of a payment alone is never a confirmation.",
    "Fail-open pass-throughs are UNGOVERNED and observe-only postings are OBSERVED; neither is reported as governed."
  ],
