                  "original_period": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                  },
                  "from": {
                    "type": "string",
                    "enum": [
                      "GOVERNED",
                      "PREVENTED",
                      "HELD_UNCONFIRMED",
                      "FALSE_HOLD",
                      "PENDING",
                      "COVERAGE_GAP",
                      "ESTIMATE",
                      "EXCLUDED",
                      "DISPUTED"
                    ]
                  },
                  "to": {
                    "type": "string",
                    "enum": [
                      "GOVERNED",
                      "PREVENTED",
                      "HELD_UNCONFIRMED",
                      "FALSE_HOLD",
                      "PENDING",
                      "COVERAGE_GAP",
                      "ESTIMATE",
                      "EXCLUDED",
                      "DISPUTED"
                    ]
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "scale": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "prevented_delta_minor": {
                    "type": "integer"
                  }
                },
                "required": [
                  "subject_digest",
                  "original_period",
                  "from",
                  "to",
                  "currency",
                  "scale",
                  "prevented_delta_minor"
                ],
                "additionalProperties": false
              },
              "maxItems": 5000
            },
            "process_map": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                  },
                  "action_type": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,119}$"
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "governed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "held": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "desk_reviews": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "customer_reviews": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "median_cycle_minutes": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "p90_cycle_minutes": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "platform",
                  "action_type",
                  "total",
                  "governed",
                  "held",
                  "desk_reviews",
                  "customer_reviews",
                  "median_cycle_minutes",
                  "p90_cycle_minutes"
                ],
                "additionalProperties": false
              },
              "maxItems": 200
            },
            "narrative": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "maxItems": 12
            },
            "entries": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": ["count", "sha256"],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "statement_id",
            "agreement_id",
            "agreement_sha256",
            "org_id",
            "environment",
            "period",
            "window",
            "closed_at",
            "calculator",
            "totals",
            "reporting",
            "counts",
            "estimates",
            "corrections",
            "process_map",
            "narrative",
            "entries"
          ],
          "additionalProperties": false
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonicalization": {
          "type": "string",
          "const": "RFC8785/JCS"
        },
        "verification": {
          "type": "string",
          "enum": ["signed", "unsigned"]
        },
        "signature": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
