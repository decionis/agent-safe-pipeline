{
  "name": "@decionis/commerce",
  "version": "0.1.6",
  "description": "Commerce Gate MCP with seven commerce-action preflights, Walmart connection mappings, a D365 guard, and a marketplace SaaS offer-submission preflight. It records policy evidence and never writes to a marketplace or ERP.",
  "author": "Decionis",
  "license": "Apache-2.0",
  "type": "module",
  "mcpName": "com.decionis/commerce-gate",
  "keywords": [
    "commercegate",
    "decionis",
    "commerce",
    "ecommerce",
    "commerce-operations",
    "marketplace-operations",
    "erp",
    "erp-guard",
    "dynamics-365",
    "transaction-authorization",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agentic-commerce",
    "commerce-governance",
    "order-acceptance",
    "price-change",
    "inventory-mutation",
    "oversell-prevention",
    "fulfillment-action",
    "promotion-change",
    "refund-request",
    "return-authorization",
    "marketplace-offer-submission",
    "partner-center",
    "aws-marketplace",
    "shadow-mode",
    "decision-dossier",
    "proof-packet",
    "agent-guardrails",
    "margin-protection",
    "margin-floor",
    "margin-floor-evaluation",
    "repricer",
    "price-preflight",
    "order-economics",
    "policy-preflight",
    "decision-evidence",
    "walmart-marketplace",
    "shopify",
    "adobe-commerce",
    "business-central"
  ],
  "homepage": "https://commerce.decionis.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decionis/agent-safe-pipeline.git",
    "directory": "packages/commerce-mcp"
  },
  "bin": {
    "commercegate-mcp": "dist/Index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json",
    "smithery.yaml",
    "glama.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/Index.ts",
    "mcp": "node --import tsx src/Index.ts",
    "build": "tsup src/Index.ts --format esm --dts --sourcemap --out-dir dist --clean",
    "prepack": "pnpm run build",
    "start": "node dist/Index.js",
    "test": "vitest run && pnpm run verify:package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "verify:package": "node scripts/VerifyPackage.mjs",
    "contract:sync": "node scripts/SyncContract.mjs",
    "contract:check": "node scripts/SyncContract.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "bugs": {
    "url": "https://github.com/decionis/agent-safe-pipeline/issues"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1136.0",
    "@aws-sdk/credential-provider-node": "3.972.83",
    "@smithy/core": "3.34.1",
    "@smithy/signature-v4": "5.7.3",
    "@smithy/types": "4.18.0"
  }
}
