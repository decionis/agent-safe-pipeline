      "path": "/companies({companyId})/salesInvoices({salesInvoiceId})/Microsoft.NAV.post",
      "action": "sales.post",
      "summary": "Post a sales invoice.",
      "facts": {
        "company_id": "/path/companyId",
        "environment": "/path/environment",
        "document_id": "/path/salesInvoiceId"
      },
      "policy_projection": null
    },
