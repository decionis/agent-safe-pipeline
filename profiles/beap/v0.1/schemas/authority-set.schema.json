{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking.decionis.com/spec/v0.1/schemas/authority-set.schema.json",
  "title": "BEAP AuthoritySet",
  "description": "The multi-party authority requirements for one intent digest and the approvals collected against them (specification section 16). Approvals bind to the intent digest, never to a transport identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "type",
    "set_id",
    "intent_digest",
    "policy",
    "requirements",
    "approvals",
    "state",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "profile": { "const": "decionis.beap/v0.1" },
    "type": { "const": "AUTHORITY_SET" },
    "set_id": { "$ref": "#/$defs/reference" },
    "intent_digest": { "$ref": "#/$defs/sha256" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "version", "digest"],
      "properties": {
        "identifier": { "$ref": "#/$defs/reference" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "role_id", "quorum", "distinct_from", "evidence_kinds"],
        "properties": {
          "requirement_id": { "$ref": "#/$defs/reference" },
          "role_id": { "$ref": "#/$defs/identifier" },
          "quorum": { "type": "integer", "minimum": 1, "maximum": 16 },
          "distinct_from": {
            "type": "array",
            "maxItems": 16,
            "items": { "$ref": "#/$defs/reference" }
          },
          "evidence_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["PRESENCE_RECEIPT", "SIGNED_ATTESTATION", "EXTERNAL_AUTHORIZATION"]
            }
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval_id",
          "requirement_id",
          "approver_ref",
          "role_id",
          "intent_digest",
          "decision",
          "approved_at",
          "expires_at",
          "evidence"
        ],
        "properties": {
          "approval_id": { "$ref": "#/$defs/reference" },
          "requirement_id": { "$ref": "#/$defs/reference" },
          "approver_ref": { "$ref": "#/$defs/reference" },
          "role_id": { "$ref": "#/$defs/identifier" },
          "intent_digest": { "$ref": "#/$defs/sha256" },
          "decision": { "type": "string", "enum": ["APPROVE", "REJECT"] },
          "approved_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference", "evidence_digest"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["PRESENCE_RECEIPT", "SIGNED_ATTESTATION", "EXTERNAL_AUTHORIZATION"]
              },
              "reference": { "$ref": "#/$defs/reference" },
              "evidence_digest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "state": {
      "type": "string",
      "enum": ["COLLECTING", "SATISFIED", "BOUND", "CONSUMED", "REJECTED", "EXPIRED", "INVALIDATED"]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,119}$" }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
