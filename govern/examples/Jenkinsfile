// Jenkins: the gate wraps the deploy stage's command. The verdict and the
// record's ids come back as properties for later stages; the build fails with
// the command never started on a BLOCK or when Decionis cannot be reached.
pipeline {
  agent any
  environment {
    DECIONIS_API_KEY = credentials('decionis-api-key')
    DECIONIS_TENANT_ID = '00000000-0000-4000-8000-000000000000' // the workspace's UUID
    GOVERN_ACTION = 'production-deploy'
    GOVERN_ENVIRONMENT = 'production'
    GOVERN_OUTPUT_FILE = 'govern.env'
  }
  stages {
    stage('Deploy') {
      steps {
        // The release's binary for this agent's platform, verified against the
        // release's SHA256SUMS before it is installed; GOVERN_VERSION pins it.
        sh 'curl -fsSL https://raw.githubusercontent.com/decionis/agent-safe-pipeline/master/govern/install.sh | GOVERN_VERSION=2.1.0 GOVERN_INSTALL_PREFIX="$WORKSPACE/.govern" sh'
        sh 'PATH="$WORKSPACE/.govern/bin:$PATH" govern run --payload "{\\"service\\":\\"api\\",\\"sha\\":\\"$GIT_COMMIT\\"}" -- ./scripts/deploy.sh'
      }
    }
    stage('Record') {
      steps {
        script {
          def proof = readProperties file: 'govern.env'
          echo "decision=${proof.GOVERN_DECISION} dossier=${proof.GOVERN_DOSSIER_ID} outcome=${proof.GOVERN_OUTCOME}"
        }
      }
    }
  }
}
