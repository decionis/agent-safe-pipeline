# Optional. Unset, every example runs on the in-process fixture authority with no
# network call and no account, and that stays supported.
#
# One variable: with no key, the run uses the credential this user keeps
# (~/.config/agentsafe/credentials.json, from `agentsafe login` or an earlier run),
# else mints a free provisional workspace from
# POST https://api.decionis.com/v1/public/agents/provision (no account, no card,
# 50 governed decisions a month) and stores it for the next run. A provisional key
# evaluates in SHADOW only.
DECIONIS_HOSTED=1

# Or set both explicitly; a key here wins over the stored one. An owned
# organization's key comes from the Decionis console and may run ENFORCEMENT.
DECIONIS_API_KEY=
DECIONIS_TENANT_ID=

# SHADOW (default): the fixture's verdict governs execution; the hosted verdict and
# dossier are recorded beside it.
# ENFORCEMENT: the hosted decision governs and its grant is claimed with Decionis;
# the fixture can only tighten it.
DECIONIS_MODE=SHADOW

# Only for staging or a loopback double (with DECIONIS_ALLOW_INSECURE_LOOPBACK=true).
# DECIONIS_API_URL=https://api.decionis.com

# Budget for the hosted call, in milliseconds. A call past it is recorded as fail-closed.
# DECIONIS_TIMEOUT_MS=4000

# Load with `set -a; . ./.env; set +a`, or `node --env-file=.env <script>`; the demo
# scripts read the environment as it is and never read this file on their own.
